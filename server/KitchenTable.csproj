<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <EmbeddedResource Include="Infrastructure/Migrations/*.sql" />
    <!-- Expo exports font assets beneath this path, which the Web SDK excludes by default. -->
    <Content Remove="wwwroot/assets/node_modules/**/*" />
    <Content Include="wwwroot/assets/node_modules/**/*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
